# Copy to backend/.env (git-ignored) and fill in. Keys stay on the server; the browser never sees them.

# Stroke recognizer, run when a check reads the selected lines: mathpix | myscript | none
RECOGNIZER=mathpix
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
MYSCRIPT_APP_KEY=
MYSCRIPT_HMAC_KEY=

# Reading fallback: Claude Haiku (DECISIONS #39); it must accept images. Every model call uses ANTHROPIC_API_KEY.
# A deepseek-* id here also works, with DEEPSEEK_API_KEY set (DECISIONS #15).
FALLBACK_READER_MODEL=claude-haiku-5-5
# Lean checking (DECISIONS #25, #27): needs ANTHROPIC_API_KEY
LEAN_MODEL=claude-sonnet-5-5
LEAN_WORDS_MODEL=claude-haiku-5-5
# Where Lean + Mathlib live. On Codespaces use a copy on the local disk: cp -a ../lean /tmp/mellow-lean
MELLOW_LEAN_DIR=/tmp/mellow-lean
ANTHROPIC_API_KEY=
