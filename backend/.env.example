# Copy to backend/.env (git-ignored) and fill in. Keys stay on the server; the browser never sees them.

# Stroke recognizer for live reading: mathpix | myscript | none
RECOGNIZER=mathpix
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
MYSCRIPT_APP_KEY=
MYSCRIPT_HMAC_KEY=

# Reading fallback: DeepSeek Flash by default (DECISIONS #15). Any claude-* model id also works
# (then set ANTHROPIC_API_KEY). The fallback reader must accept images.
DEEPSEEK_API_KEY=
FALLBACK_READER_MODEL=deepseek-flash
# Lean checking (DECISIONS #25, #27): needs ANTHROPIC_API_KEY
LEAN_MODEL=claude-sonnet-5-5
LEAN_WORDS_MODEL=claude-haiku-5-5
# Where Lean + Mathlib live. On Codespaces use a copy on the local disk: cp -a ../lean /tmp/mellow-lean
MELLOW_LEAN_DIR=/tmp/mellow-lean
ANTHROPIC_API_KEY=
